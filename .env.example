# ==========================================================
# BizOS Multi-Tenant Platform Configuration
# ==========================================================

# 1. Supabase (Free Tier: Postgres + pgvector + Auth + Storage)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. LLM Inference (Free Tier)
# Groq API for deployed demo (fast inference, generous free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (used for text-embedding-004 768-dim embeddings & fallback chat)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Local Dev LLM (Optional - if using Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434

# 3. Security & Cron Secrets
# Protects the weekly digest cron endpoint from unauthorized execution
CRON_SECRET=bizos_super_secure_cron_token_change_in_prod

# 4. Optional Upstash Redis (Alternative to Supabase table for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
